  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "schemaBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^contracts/[A-Za-z0-9._/-]+\\.json$"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "path",
        "sha256"
      ],
      "properties": {
        "role": {
          "enum": [
            "INDEPENDENT_GENERATOR_VERIFIER",
            "CONFORMANCE_TEST"
          ]
