{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qman.local/schemas/vmware-experiment-result-v1.json",
  "title": "Qman VMware reference experiment result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "caseId",
    "legacyIds",
    "subject",
    "runId",
    "startedAt",
    "sutProfile",
    "techStories",
    "basisKinds",
    "sourceIds",
    "inputs",
    "expected",
    "observed",
    "verdict",
    "artifacts",
    "limitations"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "caseId": {
      "type": "string",
      "pattern": "^VMW-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
    },
    "legacyIds": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "subject": {
      "const": "VMWARE_ESXI"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "finishedAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "sutProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environmentClass",
        "esxiVersion",
        "esxiBuild",
        "apiVersion",
        "virtualHardware",
        "serverModel",
        "biosVersion",
        "deviceIdentity",
        "deviceFirmware",
        "guestOs",
        "guestDriver",
        "workload"
      ],
      "properties": {
        "environmentClass": {
          "enum": ["NESTED_INSTRUMENTED_REFERENCE", "PHYSICAL_QUALIFICATION"]
        },
        "esxiVersion": {"type": "string", "minLength": 1},
        "esxiBuild": {"type": "string", "minLength": 1},
        "apiVersion": {"type": "string", "minLength": 1},
        "virtualHardware": {"type": "string", "minLength": 1},
        "serverModel": {"type": "string", "minLength": 1},
        "biosVersion": {"type": "string", "minLength": 1},
        "deviceIdentity": {"type": "string", "minLength": 1},
        "deviceFirmware": {"type": "string", "minLength": 1},
        "guestOs": {"type": "string", "minLength": 1},
        "guestDriver": {"type": "string", "minLength": 1},
        "workload": {"type": "string", "minLength": 1}
      }
    },
    "techStories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^TS-F[0-9]+-[0-9]{2}$"
      },
      "uniqueItems": true
    },
    "basisKinds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": ["OFFICIAL_CONTRACT", "OBSERVED_BEHAVIOR", "INFERRED_MECHANISM"]
      },
      "uniqueItems": true
    },
    "sourceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^VMW-SRC-[0-9]{3}$"
      },
      "uniqueItems": true
    },
    "inputs": {
      "type": "object"
    },
    "expected": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "observed": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "verdict": {
      "enum": ["PASS", "PARTIAL", "BLOCKED", "FAIL"]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "kind"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "kind": {
            "enum": [
              "INPUT",
              "API",
              "TASK_EVENT",
              "VMX",
              "HOST_LOG",
              "VM_LOG",
              "GUEST",
              "L0_TRACE",
              "SUMMARY"
            ]
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  }
}
