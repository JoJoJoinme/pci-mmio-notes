.encoding = "UTF-8"
config.version = "8"
virtualHW.version = "20"
displayName = "dynamic-directpath-probe"
guestOS = "other5xlinux-64"
firmware = "efi"
memSize = "2048"
numvcpus = "1"
svga.present = "TRUE"
vmci0.present = "TRUE"
hpet0.present = "TRUE"
floppy0.present = "FALSE"
chipset.motherboardLayout = "acpi"
pciBridge0.present = "TRUE"
pciBridge0.virtualDev = "pciRootBridge"
pciBridge0.functions = "1"
pciBridge1.present = "TRUE"
pciBridge1.virtualDev = "pciRootBridge"
pciBridge1.functions = "1"
ethernet0.virtualDev = "e1000"
ethernet0.networkName = "VM Network"
ethernet0.present = "TRUE"
ide1:0.present = "TRUE"
ide1:0.deviceType = "cdrom-image"
ide1:0.fileName = "/vmfs/volumes/pci-mmio-local/iso/esxi-l3-pci-probe.iso"
ide1:0.startConnected = "TRUE"
serial0.present = "TRUE"
serial0.fileType = "file"
serial0.fileName = "guest-serial-dynamic-directpath.log"
serial0.yieldOnMsrRead = "TRUE"
bios.bootOrder = "cdrom"
sched.mem.min = "2048"
sched.mem.minSize = "2048"
sched.mem.pin = "TRUE"
