From: PCI DirectPath Lab <lab@example.invalid>
Subject: [PATCH] igb: add lab-only PF and VF device ID overrides

Allow black-box hypervisor tests to present the QEMU igb register model under
another publicly documented member of the same Intel igb family.  Defaults
remain the QEMU 82576 PF/VF IDs.  The override is an experimental test aid and
does not claim complete hardware equivalence.
---
 hw/net/igb.c | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/hw/net/igb.c b/hw/net/igb.c
--- a/hw/net/igb.c
+++ b/hw/net/igb.c
@@ -79,4 +79,6 @@ struct IGBState {
 
     IGBCore core;
     bool has_flr;
+    uint16_t device_id;
+    uint16_t vf_device_id;
 };
@@ -388,5 +390,7 @@ static void igb_pci_realize(PCIDevice *pci_dev, Error **errp)
 
     pci_dev->config_write = igb_write_config;
 
+    pci_config_set_device_id(pci_dev->config, s->device_id);
+
     pci_dev->config[PCI_CACHE_LINE_SIZE] = 0x10;
     pci_dev->config[PCI_INTERRUPT_PIN] = 1;
@@ -446,6 +450,6 @@ static void igb_pci_realize(PCIDevice *pci_dev, Error **errp)
     pcie_ari_init(pci_dev, 0x150);
 
     if (!pcie_sriov_pf_init(pci_dev, IGB_CAP_SRIOV_OFFSET, TYPE_IGBVF,
-                            IGB_82576_VF_DEV_ID, IGB_MAX_VF_FUNCTIONS,
+                            s->vf_device_id, IGB_MAX_VF_FUNCTIONS,
                             IGB_MAX_VF_FUNCTIONS, IGB_VF_OFFSET, IGB_VF_STRIDE,
                             errp)) {
@@ -597,4 +601,8 @@ static const VMStateDescription igb_vmstate = {
 static const Property igb_properties[] = {
     DEFINE_NIC_PROPERTIES(IGBState, conf),
     DEFINE_PROP_BOOL("x-pcie-flr-init", IGBState, has_flr, true),
+    DEFINE_PROP_UINT16("x-pci-device-id", IGBState, device_id,
+                       E1000_DEV_ID_82576),
+    DEFINE_PROP_UINT16("x-pci-vf-device-id", IGBState, vf_device_id,
+                       IGB_82576_VF_DEV_ID),
 };
-- 
